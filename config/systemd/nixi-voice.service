[Unit]
Description=Nixi local wake-word and voice command daemon
Requires=nixi-server.service
After=nixi-server.service pipewire.service graphical-session.target

[Service]
Type=simple
WorkingDirectory=%h/Personal/nixie
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/uv run nixi-voice
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
